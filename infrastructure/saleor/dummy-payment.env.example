# Browser/Dashboard access to the locally running Saleor App
APP_IFRAME_BASE_URL=http://localhost:3001

# Saleor Core runs inside Docker and reaches the host through this address
APP_API_BASE_URL=http://host.docker.internal:3001

# Local-only DynamoDB credentials.
# These are not real AWS credentials.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_REGION=us-east-1

DYNAMODB_MAIN_TABLE_NAME=saleor-dummy-payment

# Dummy Payment App runs on the host and accesses DynamoDB Local through port 8001
AWS_ENDPOINT_URL_DYNAMODB=http://localhost:8001
