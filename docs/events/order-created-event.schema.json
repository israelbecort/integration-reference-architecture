{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/order-created-event.schema.json",
  "title": "Order Created Event",
  "description": "Event published when an order has been accepted and is ready for asynchronous ERP processing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "occurredAt",
    "correlationId",
    "source",
    "data"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier of the event.",
      "examples": [
        "90b9f215-c19f-4abc-a2c4-2cc7220c010d"
      ]
    },
    "eventType": {
      "type": "string",
      "const": "ORDER_CREATED",
      "description": "Business event type."
    },
    "eventVersion": {
      "type": "string",
      "const": "1.0",
      "description": "Version of the event contract."
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp indicating when the business event occurred.",
      "examples": [
        "2026-09-05T07:15:00Z"
      ]
    },
    "correlationId": {
      "type": "string",
      "format": "uuid",
      "description": "Identifier used to trace the transaction across the integration flow.",
      "examples": [
        "b37166f4-8a39-4ffd-9599-c42ca48b83d0"
      ]
    },
    "source": {
      "type": "string",
      "const": "integration-service",
      "description": "Component that produced the event."
    },
    "data": {
      "$ref": "#/$defs/orderData"
    }
  },
  "$defs": {
    "orderData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orderId",
        "externalOrderId",
        "customerId",
        "currency",
        "items",
        "shippingAddress"
      ],
      "properties": {
        "orderId": {
          "type": "string",
          "format": "uuid",
          "description": "Internal identifier of the order.",
          "examples": [
            "33c58292-f36e-4ca3-a421-c22da73e93e5"
          ]
        },
        "externalOrderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Order identifier generated by the source e-commerce platform.",
          "examples": [
            "WEB-2026-000123"
          ]
        },
        "customerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Identifier of the customer associated with the order.",
          "examples": [
            "CUST-10045"
          ]
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 currency code.",
          "examples": [
            "EUR"
          ]
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "description": "Products included in the order.",
          "items": {
            "$ref": "#/$defs/orderItem"
          }
        },
        "shippingAddress": {
          "$ref": "#/$defs/shippingAddress"
        }
      }
    },
    "orderItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productId",
        "quantity",
        "unitPrice"
      ],
      "properties": {
        "productId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Identifier of the product.",
          "examples": [
            "PROD-001"
          ]
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of product units.",
          "examples": [
            2
          ]
        },
        "unitPrice": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Price per product unit.",
          "examples": [
            29.95
          ]
        }
      }
    },
    "shippingAddress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "addressLine1",
        "city",
        "postalCode",
        "country"
      ],
      "properties": {
        "addressLine1": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "examples": [
            "123 Example Street"
          ]
        },
        "addressLine2": {
          "type": "string",
          "maxLength": 200,
          "examples": [
            "Apartment 4B"
          ]
        },
        "city": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "examples": [
            "Seville"
          ]
        },
        "postalCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "examples": [
            "41001"
          ]
        },
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$",
          "description": "ISO 3166-1 alpha-2 country code.",
          "examples": [
            "ES"
          ]
        }
      }
    }
  }
}
